<Window x:Class="MaterialDockerImage.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Material Docker Image" Width="1440" Height="960" MinWidth="960" MinHeight="720" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <SolidColorBrush x:Key="Surface" Color="#101419"/><SolidColorBrush x:Key="Panel" Color="#1A2027"/><SolidColorBrush x:Key="Field" Color="#252C35"/><SolidColorBrush x:Key="Ink" Color="#E1E7EF"/><SolidColorBrush x:Key="Muted" Color="#AAB7C8"/><SolidColorBrush x:Key="Accent" Color="#A6C8FF"/><SolidColorBrush x:Key="AccentInk" Color="#092C54"/><SolidColorBrush x:Key="Outline" Color="#455365"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Field}"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="4"/><Setter Property="MinHeight" Value="40"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Outline}" BorderThickness="1" CornerRadius="19" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Opacity" Value=".8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="border" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="border" Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource Field}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="CaretBrush" Value="{DynamicResource Accent}"/><Setter Property="BorderBrush" Value="{DynamicResource Outline}"/><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="MinHeight" Value="38"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="36"/><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="8"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Margin" Value="4,8"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="RowBackground" Value="{DynamicResource Panel}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource Field}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="RowHeight" Value="46"/><Setter Property="ColumnHeaderHeight" Value="42"/><Setter Property="AutoGenerateColumns" Value="True"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource Field}"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Padding" Value="12,8"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="10,6"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Field}"/><Setter Property="Padding" Value="14,10"/><Setter Property="Margin" Value="2"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="180"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource Panel}" Padding="24,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Material Docker Image" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="Provenance" FontSize="11" Foreground="{DynamicResource Muted}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Engine context" VerticalAlignment="Center" Margin="12,0"/><ComboBox x:Name="Contexts" Width="190"/><Button x:Name="RefreshContext" Content="Refresh contexts"/><Border Background="{DynamicResource Field}" CornerRadius="16" Padding="12,8" Margin="8,0"><TextBlock x:Name="EngineState" Text="Not checked"/></Border></StackPanel></Grid></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource Panel}" Padding="12"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="WORKSPACE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Muted}" Margin="12,12"/><TextBlock x:Name="WorkspaceName" Text="Local engine" FontSize="16" Margin="12,0,12,12"/><Button x:Name="NewTab" Content="New tab"/></StackPanel><StackPanel x:Name="Navigation"/></DockPanel></Border><TabControl x:Name="Workspaces" Grid.Column="1" Margin="18,14"/></Grid>
  <Border Grid.Row="2" Background="{DynamicResource Field}" Padding="18,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Notice" Text="Ready. Select a workflow, or run Setup to connect an engine." VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="ClearOutput" Content="Clear output" Padding="12,4" MinHeight="28"/><Button x:Name="CancelOperation" Content="Cancel" IsEnabled="False" Padding="12,4" MinHeight="28"/></StackPanel></Grid></Border>
  <TextBox Grid.Row="3" x:Name="Output" IsReadOnly="True" AcceptsReturn="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0" BorderThickness="0" Padding="18" AutomationProperties.Name="Operation output"/>
 </Grid>
</Window>
