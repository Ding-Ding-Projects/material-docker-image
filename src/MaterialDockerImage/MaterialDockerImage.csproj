<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MaterialDockerImage</AssemblyName>
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Icon\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibGit2Sharp" Version="0.32.0" />
    <PackageReference Include="System.Speech" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\Icon\app.ico" />
    <EmbeddedResource Include="..\..\docs\features\*.md" LinkBase="Docs" LogicalName="docs/%(Filename)%(Extension)" />
    <!-- Generated by build/make-changelog.ps1 from git log; absent in a plain checkout, and the app then says so. -->
    <EmbeddedResource Include="Assets\changelog.json" LogicalName="changelog.json" Condition="Exists('Assets\changelog.json')" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="BuildTimestamp" Value="$(BuildTimestamp)" />
    <AssemblyMetadata Include="SquirrelAwareVersion" Value="1" />
  </ItemGroup>
</Project>
