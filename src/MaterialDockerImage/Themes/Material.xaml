<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:m="clr-namespace:MaterialDockerImage.Services">
  <!-- Material 3 roles. Brushes are replaced at runtime by Services/Theme.cs; these are the dark defaults. -->
  <SolidColorBrush x:Key="Surface" Color="#111318"/>
  <SolidColorBrush x:Key="SurfaceLowest" Color="#0C0E13"/>
  <SolidColorBrush x:Key="SurfaceLow" Color="#191C20"/>
  <SolidColorBrush x:Key="SurfaceContainer" Color="#1D2024"/>
  <SolidColorBrush x:Key="SurfaceHigh" Color="#282A2F"/>
  <SolidColorBrush x:Key="SurfaceHighest" Color="#33353A"/>
  <SolidColorBrush x:Key="OnSurface" Color="#E2E2E9"/>
  <SolidColorBrush x:Key="OnSurfaceVariant" Color="#C4C6D0"/>
  <SolidColorBrush x:Key="Outline" Color="#8E9099"/>
  <SolidColorBrush x:Key="OutlineVariant" Color="#44474F"/>
  <SolidColorBrush x:Key="Primary" Color="#ADC6FF"/>
  <SolidColorBrush x:Key="OnPrimary" Color="#002E69"/>
  <SolidColorBrush x:Key="PrimaryContainer" Color="#004494"/>
  <SolidColorBrush x:Key="OnPrimaryContainer" Color="#D8E2FF"/>
  <SolidColorBrush x:Key="SecondaryContainer" Color="#3E4759"/>
  <SolidColorBrush x:Key="OnSecondaryContainer" Color="#DAE2F9"/>
  <SolidColorBrush x:Key="Tertiary" Color="#82D3E0"/>
  <SolidColorBrush x:Key="TertiaryContainer" Color="#004F58"/>
  <SolidColorBrush x:Key="OnTertiaryContainer" Color="#A2EEFB"/>
  <SolidColorBrush x:Key="Success" Color="#7FD99A"/>
  <SolidColorBrush x:Key="SuccessContainer" Color="#005227"/>
  <SolidColorBrush x:Key="OnSuccessContainer" Color="#9CF6B4"/>
  <SolidColorBrush x:Key="Warning" Color="#F9BD5C"/>
  <SolidColorBrush x:Key="WarningContainer" Color="#5C3F00"/>
  <SolidColorBrush x:Key="OnWarningContainer" Color="#FFDDB3"/>
  <SolidColorBrush x:Key="Error" Color="#FFB4AB"/>
  <SolidColorBrush x:Key="OnError" Color="#690005"/>
  <SolidColorBrush x:Key="ErrorContainer" Color="#93000A"/>
  <SolidColorBrush x:Key="OnErrorContainer" Color="#FFDAD6"/>
  <SolidColorBrush x:Key="Scrim" Color="#99000000"/>
  <SolidColorBrush x:Key="HoverLayer" Color="#14E2E2E9"/>
  <SolidColorBrush x:Key="PressLayer" Color="#24E2E2E9"/>

  <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
  <FontFamily x:Key="IconFont">pack://application:,,,/MaterialDockerImage;component/Assets/Fonts/#Material Symbols Rounded Outline</FontFamily>
  <FontFamily x:Key="IconFontFilled">pack://application:,,,/MaterialDockerImage;component/Assets/Fonts/#Material Symbols Rounded Filled</FontFamily>
  <sys:Double x:Key="TargetHeight">40</sys:Double>
  <!-- Shape and density tokens. Services/AppearanceRuntime.cs rewrites them from the corner radius scale and density. -->
  <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
  <CornerRadius x:Key="RadiusMedium">12</CornerRadius>
  <CornerRadius x:Key="RadiusLarge">16</CornerRadius>
  <CornerRadius x:Key="RadiusExtraLarge">28</CornerRadius>
  <CornerRadius x:Key="RadiusPill">20</CornerRadius>
  <Thickness x:Key="ButtonPadding">20,0</Thickness>
  <Thickness x:Key="FieldPadding">10,0</Thickness>
  <FontFamily x:Key="RailIconFont">pack://application:,,,/MaterialDockerImage;component/Assets/Fonts/#Material Symbols Rounded Outline</FontFamily>

  <!-- Focus ring drawn outside controls. -->
  <Style x:Key="FocusRing">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-3" CornerRadius="22" BorderThickness="2" BorderBrush="{DynamicResource Primary}" SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Buttons -->
  <Style x:Key="Btn.Base" TargetType="Button">
    <Setter Property="FontFamily" Value="{DynamicResource TextFont}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="MinHeight" Value="{DynamicResource TargetHeight}"/>
    <Setter Property="Padding" Value="{DynamicResource ButtonPadding}"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="{DynamicResource SecondaryContainer}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource RadiusPill}" SnapsToDevicePixels="True"/>
            <Border x:Name="state" Background="Transparent" CornerRadius="{DynamicResource RadiusPill}"/>
            <Border x:Name="ripple" Background="{DynamicResource PressLayer}" CornerRadius="{DynamicResource RadiusPill}" Opacity="0" IsHitTestVisible="False" m:MotionAttached.Effect="Ripple"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="state" Property="Background" Value="{DynamicResource HoverLayer}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="state" Property="Background" Value="{DynamicResource PressLayer}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Btn.Filled" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="{DynamicResource Primary}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnPrimary}"/>
  </Style>
  <Style x:Key="Btn.Tonal" TargetType="Button" BasedOn="{StaticResource Btn.Base}"/>
  <Style x:Key="Btn.Outlined" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Primary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Outline}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="16,0"/>
  </Style>
  <Style x:Key="Btn.Text" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Primary}"/>
    <Setter Property="Padding" Value="12,0"/>
  </Style>
  <Style x:Key="Btn.Danger" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="{DynamicResource ErrorContainer}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnErrorContainer}"/>
  </Style>
  <Style x:Key="Btn.Icon" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}"/>
    <Setter Property="Width" Value="40"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontFamily" Value="{DynamicResource IconFont}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="FontSize" Value="20"/>
  </Style>
  <Style x:Key="Btn.Window" TargetType="Button">
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="48"/>
    <Setter Property="FontFamily" Value="{DynamicResource IconFont}"/>
    <Setter Property="FontSize" Value="18"/>
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bg" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverLayer}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource PressLayer}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Btn.WindowClose" TargetType="Button" BasedOn="{StaticResource Btn.Window}">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource Btn.Tonal}"/>

  <!-- Navigation rail item -->
  <Style x:Key="Rail.Item" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="root" Background="Transparent" Width="80" MinHeight="40" Padding="0,4" Margin="0,1">
            <StackPanel VerticalAlignment="Center">
              <Border x:Name="pill" Width="56" Height="32" CornerRadius="16" Background="Transparent" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5" m:MotionAttached.Effect="RailPill">
                <Border.Child>
                  <Grid>
                    <TextBlock x:Name="iconOutline" Text="{TemplateBinding Tag}" FontFamily="{DynamicResource RailIconFont}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                    <TextBlock x:Name="iconFilled" Text="{TemplateBinding Tag}" FontFamily="{DynamicResource IconFontFilled}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource OnSecondaryContainer}" Visibility="Collapsed"/>
                  </Grid>
                </Border.Child>
              </Border>
              <ContentPresenter x:Name="label" HorizontalAlignment="Center" Margin="0,3,0,0" TextElement.FontSize="12" TextBlock.TextAlignment="Center"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="pill" Property="Background" Value="{DynamicResource HoverLayer}"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="pill" Property="Background" Value="{DynamicResource SecondaryContainer}"/>
              <Setter TargetName="iconOutline" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="iconFilled" Property="Visibility" Value="Visible"/>
              <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
              <Setter TargetName="label" Property="TextElement.FontWeight" Value="SemiBold"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource Primary}"/><Setter TargetName="pill" Property="BorderThickness" Value="2"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Segmented button -->
  <Style x:Key="Segment" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
    <Setter Property="MinHeight" Value="{DynamicResource TargetHeight}"/>
    <Setter Property="Padding" Value="14,0"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bg" Background="Transparent" BorderBrush="{DynamicResource Outline}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
            <!-- A DockPanel passes the segment's real width to the label, so a long label ends in an ellipsis instead of running past the segment. -->
            <DockPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <DockPanel.Resources>
                <Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
              </DockPanel.Resources>
              <TextBlock x:Name="check" DockPanel.Dock="Left" Text="&#xE668;" FontFamily="{DynamicResource IconFont}" FontSize="18" Margin="0,0,6,0" Visibility="Collapsed" VerticalAlignment="Center" TextTrimming="None"/>
              <ContentPresenter VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverLayer}"/></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource SecondaryContainer}"/><Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}"/><Setter TargetName="check" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Primary}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Tab strip tab -->
  <Style x:Key="Tab.Item" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Padding" Value="14,0,6,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bg" Background="Transparent" CornerRadius="12,12,0,0" Padding="{TemplateBinding Padding}" BorderBrush="{DynamicResource Primary}" BorderThickness="0">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverLayer}"/></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource SurfaceContainer}"/><Setter Property="Foreground" Value="{DynamicResource OnSurface}"/><Setter TargetName="bg" Property="BorderThickness" Value="0,0,0,2"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bg" Property="BorderThickness" Value="2"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Text fields -->
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource SurfaceLowest}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Primary}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Primary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariant}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="{DynamicResource FieldPadding}"/>
    <Setter Property="MinHeight" Value="{DynamicResource TargetHeight}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource RadiusSmall}" SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Outline}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Primary}"/><Setter TargetName="border" Property="BorderThickness" Value="2"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            <Trigger Property="IsReadOnly" Value="True"><Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceContainer}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Field.Code" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="AcceptsReturn" Value="True"/>
    <Setter Property="AcceptsTab" Value="True"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="VerticalContentAlignment" Value="Top"/>
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
  </Style>
  <Style x:Key="Field.Search" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="4,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" Focusable="False"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="PasswordBox">
    <Setter Property="Background" Value="{DynamicResource SurfaceLowest}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Primary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariant}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource RadiusSmall}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Primary}"/><Setter TargetName="border" Property="BorderThickness" Value="2"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ComboBox -->
  <Style x:Key="ComboToggle" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="border" Background="{DynamicResource SurfaceLowest}" BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}">
            <TextBlock Text="&#xE5CF;" FontFamily="{DynamicResource IconFont}" FontSize="20" Foreground="{DynamicResource OnSurfaceVariant}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Outline}"/></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Primary}"/><Setter TargetName="border" Property="BorderThickness" Value="2"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
    <Setter Property="MinHeight" Value="{DynamicResource TargetHeight}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="toggle" Style="{StaticResource ComboToggle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
            <ContentPresenter x:Name="selected" IsHitTestVisible="False" Margin="12,0,36,0" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
            <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Margin="2,2,32,2" BorderThickness="0" Background="Transparent" IsReadOnly="{TemplateBinding IsReadOnly}"/>
            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border Background="{DynamicResource SurfaceHigh}" CornerRadius="{DynamicResource RadiusSmall}" Margin="0,4,8,8" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="1">
                <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.35"/></Border.Effect>
                <ScrollViewer Margin="0,6" SnapsToDevicePixels="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEditable" Value="True"><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/><Setter TargetName="selected" Property="Visibility" Value="Hidden"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="bg" Background="Transparent" Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverLayer}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource SecondaryContainer}"/><Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- CheckBox and switch -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="ring" Width="36" Height="36" CornerRadius="18" Background="Transparent" BorderBrush="{DynamicResource Primary}" BorderThickness="0">
              <TextBlock x:Name="glyph" Text="&#xE835;" FontFamily="{DynamicResource IconFont}" FontSize="22" Foreground="{DynamicResource OnSurfaceVariant}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ring" Property="Background" Value="{DynamicResource HoverLayer}"/></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="glyph" Property="Text" Value="&#xE9DE;"/><Setter TargetName="glyph" Property="FontFamily" Value="{DynamicResource IconFontFilled}"/><Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource Primary}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ring" Property="BorderThickness" Value="2"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
    <Setter Property="MinHeight" Value="44"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Border x:Name="track" Grid.Column="1" Width="52" Height="32" CornerRadius="16" Background="{DynamicResource SurfaceHighest}" BorderBrush="{DynamicResource Outline}" BorderThickness="2" VerticalAlignment="Center">
              <Border x:Name="thumb" Width="16" Height="16" CornerRadius="8" Background="{DynamicResource Outline}" HorizontalAlignment="Left" Margin="6,0,0,0" m:MotionAttached.Effect="SwitchThumb"/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="track" Property="Background" Value="{DynamicResource Primary}"/>
              <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Primary}"/>
              <Setter TargetName="thumb" Property="Background" Value="{DynamicResource OnPrimary}"/>
              <Setter TargetName="thumb" Property="Width" Value="24"/>
              <Setter TargetName="thumb" Property="Height" Value="24"/>
              <Setter TargetName="thumb" Property="CornerRadius" Value="12"/>
              <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
              <Setter TargetName="thumb" Property="Margin" Value="0,0,2,0"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource OnSurface}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Chip" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="bg" CornerRadius="{DynamicResource RadiusSmall}" BorderThickness="1" BorderBrush="{DynamicResource OutlineVariant}" Background="Transparent" Padding="{TemplateBinding Padding}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="check" Text="&#xE668;" FontFamily="{DynamicResource IconFont}" FontSize="16" Margin="0,0,6,0" Visibility="Collapsed" VerticalAlignment="Center"/>
              <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverLayer}"/></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource SecondaryContainer}"/><Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource SecondaryContainer}"/><Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}"/><Setter TargetName="check" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Primary}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Lists -->
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
  </Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="bg" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}" Margin="0,1" BorderBrush="{DynamicResource Primary}" BorderThickness="0">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverLayer}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource SecondaryContainer}"/><Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bg" Property="BorderThickness" Value="2"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ListView">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
    <Setter Property="SelectionMode" Value="Extended"/>
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
  </Style>
  <Style TargetType="ListViewItem">
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
    <Setter Property="MinHeight" Value="48"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <Border x:Name="bg" Background="Transparent" CornerRadius="10" Margin="0,1" BorderBrush="{DynamicResource Primary}" BorderThickness="0">
            <GridViewRowPresenter VerticalAlignment="Center" Margin="0,4"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverLayer}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource SurfaceHigh}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bg" Property="BorderThickness" Value="2"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="GridViewColumnHeader">
    <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GridViewColumnHeader">
          <Border x:Name="bg" Background="Transparent" BorderBrush="{DynamicResource SurfaceHigh}" BorderThickness="0,0,0,1" Padding="8,10">
            <Grid>
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
              <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="6" Margin="0,0,-4,0" Cursor="SizeWE" Opacity="0"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverLayer}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Menus and tooltips -->
  <Style TargetType="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource SurfaceHigh}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="HasDropShadow" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusMedium}" Padding="0,8" MinWidth="240" BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="bg" Background="Transparent" Padding="16,0" MinHeight="{TemplateBinding MinHeight}">
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" TextElement.FontFamily="{DynamicResource IconFont}" TextElement.FontSize="18"/>
              <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
              <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource Outline}" FontSize="12" Margin="24,0,0,0" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverLayer}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Margin="0,6" Background="{DynamicResource OutlineVariant}"/></ControlTemplate></Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{DynamicResource Surface}"/>
    <Setter Property="Background" Value="{DynamicResource OnSurface}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="MaxWidth" Value="360"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="8,4"><ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}"><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></ContentPresenter.Resources></ContentPresenter></Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Scroll bars -->
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="t" CornerRadius="4" Background="{DynamicResource OutlineVariant}"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Background" Value="{DynamicResource Outline}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10"/>
    <Setter Property="MinWidth" Value="10"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2">
            <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="MinHeight" Value="10"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="2">
                <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Slider -->
  <Style x:Key="SliderThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="t" Width="4" Height="28" CornerRadius="2" Background="{DynamicResource Primary}"/><ControlTemplate.Triggers><Trigger Property="IsDragging" Value="True"><Setter TargetName="t" Property="Width" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SliderTrackFill" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Height="12" CornerRadius="6,2,2,6" Background="{DynamicResource Primary}" Margin="0,0,4,0"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SliderTrackRest" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Height="12" CornerRadius="2,6,6,2" Background="{DynamicResource SecondaryContainer}" Margin="4,0,0,0"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider">
    <Setter Property="MinHeight" Value="44"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="IsMoveToPointEnabled" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Border x:Name="focus" BorderBrush="Transparent" BorderThickness="0,0,0,2">
            <Track x:Name="PART_Track" VerticalAlignment="Center">
              <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SliderTrackFill}" Command="Slider.DecreaseLarge"/></Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SliderTrackRest}" Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton>
              <Track.Thumb><Thumb Style="{StaticResource SliderThumb}"/></Track.Thumb>
            </Track>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focus" Property="BorderBrush" Value="{DynamicResource Primary}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Progress -->
  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="4"/>
    <Setter Property="Foreground" Value="{DynamicResource Primary}"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceHighest}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid ClipToBounds="True">
            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2"/>
            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left"/>
            <Border x:Name="sweep" Width="72" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left" Visibility="Collapsed">
              <Border.RenderTransform><TranslateTransform x:Name="sweepX" X="-72"/></Border.RenderTransform>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsIndeterminate" Value="True">
              <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="sweep" Property="Visibility" Value="Visible"/>
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="sweepStory">
                  <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="sweepX" Storyboard.TargetProperty="X" From="-72" To="400" Duration="0:0:1.4"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions><StopStoryboard BeginStoryboardName="sweepStory"/></Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Expander -->
  <Style TargetType="Expander">
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <DockPanel>
            <ToggleButton x:Name="header" DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Cursor="Hand" FocusVisualStyle="{x:Null}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="bg" Background="Transparent" MinHeight="44" CornerRadius="8" Padding="4,0">
                    <Grid>
                      <ContentPresenter VerticalAlignment="Center" TextElement.FontWeight="SemiBold"/>
                      <TextBlock x:Name="chev" Text="&#xE5CF;" FontFamily="{DynamicResource IconFont}" FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource OnSurfaceVariant}"/>
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverLayer}"/></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="chev" Property="Text" Value="&#xE5CE;"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource PressLayer}"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
              <ContentPresenter ContentSource="Header" Content="{TemplateBinding Header}"/>
            </ToggleButton>
            <ContentPresenter x:Name="content" Visibility="Collapsed" Margin="4,4,4,8" m:MotionAttached.Effect="Reveal"/>
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="content" Property="Visibility" Value="Visible"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Radio button (default, used for choice cards and option lists) -->
  <Style TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="card" Background="Transparent" CornerRadius="{DynamicResource RadiusMedium}" BorderThickness="1" BorderBrush="{DynamicResource OutlineVariant}" Padding="{TemplateBinding Padding}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,12,0">
                <Ellipse x:Name="ring" Stroke="{DynamicResource OnSurfaceVariant}" StrokeThickness="2"/>
                <Ellipse x:Name="dot" Width="10" Height="10" Fill="{DynamicResource Primary}" Visibility="Collapsed"/>
              </Grid>
              <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="card" Property="Background" Value="{DynamicResource HoverLayer}"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
              <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Primary}"/>
              <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource Primary}"/>
              <Setter TargetName="card" Property="Background" Value="{DynamicResource SurfaceContainer}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="card" Property="BorderThickness" Value="2"/><Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource Primary}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Default toggle button behaves like a chip -->
  <Style TargetType="ToggleButton" BasedOn="{StaticResource Chip}"/>

  <!-- Calendar and date picker -->
  <Style x:Key="CalendarDayButton" TargetType="CalendarDayButton">
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
    <Setter Property="Width" Value="36"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CalendarDayButton">
          <Grid>
            <Ellipse x:Name="bg" Fill="Transparent"/>
            <Ellipse x:Name="today" Stroke="{DynamicResource Primary}" StrokeThickness="1" Visibility="Collapsed"/>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontSize="13"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Fill" Value="{DynamicResource HoverLayer}"/></Trigger>
            <Trigger Property="IsToday" Value="True"><Setter TargetName="today" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="bg" Property="Fill" Value="{DynamicResource Primary}"/><Setter Property="Foreground" Value="{DynamicResource OnPrimary}"/></Trigger>
            <Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="{DynamicResource Outline}"/></Trigger>
            <Trigger Property="IsBlackedOut" Value="True"><Setter Property="Opacity" Value="0.38"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CalendarButton" TargetType="CalendarButton">
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
    <Setter Property="Width" Value="64"/>
    <Setter Property="Height" Value="44"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CalendarButton">
          <Grid>
            <Border x:Name="bg" CornerRadius="16" Background="Transparent"/>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverLayer}"/></Trigger>
            <Trigger Property="HasSelectedDays" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource SecondaryContainer}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CalendarItemStyle" TargetType="CalendarItem">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CalendarItem">
          <ControlTemplate.Resources>
            <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
              <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceVariant}" HorizontalAlignment="Center" Margin="0,4"/>
            </DataTemplate>
          </ControlTemplate.Resources>
          <Border Background="{DynamicResource SurfaceHigh}" CornerRadius="16" Padding="12">
            <DockPanel>
              <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="PART_PreviousButton" Style="{StaticResource Btn.Icon}" Content="&#xE5CB;" AutomationProperties.Name="Previous"/>
                <Button x:Name="PART_HeaderButton" Grid.Column="1" Style="{StaticResource Btn.Text}" FontSize="14" Foreground="{DynamicResource OnSurface}"/>
                <Button x:Name="PART_NextButton" Grid.Column="2" Style="{StaticResource Btn.Icon}" Content="&#xE5CC;" AutomationProperties.Name="Next"/>
              </Grid>
              <Grid>
                <Grid x:Name="PART_MonthView" Visibility="Visible">
                  <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                </Grid>
                <Grid x:Name="PART_YearView" Visibility="Hidden">
                  <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                </Grid>
              </Grid>
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}}" Value="Year">
              <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/>
              <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}}" Value="Decade">
              <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/>
              <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Calendar">
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
    <Setter Property="CalendarDayButtonStyle" Value="{StaticResource CalendarDayButton}"/>
    <Setter Property="CalendarButtonStyle" Value="{StaticResource CalendarButton}"/>
    <Setter Property="CalendarItemStyle" Value="{StaticResource CalendarItemStyle}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Calendar">
          <CalendarItem x:Name="PART_CalendarItem" Style="{TemplateBinding CalendarItemStyle}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="DatePickerTextBox">
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Primary}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DatePickerTextBox">
          <Grid>
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"/>
            <ContentControl x:Name="PART_Watermark" IsHitTestVisible="False" Foreground="{DynamicResource Outline}" VerticalAlignment="Center" Margin="2,0,0,0" Focusable="False"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="DatePicker">
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="IsTodayHighlighted" Value="True"/>
    <Setter Property="SelectedDateFormat" Value="Short"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DatePicker">
          <Border x:Name="border" Background="{DynamicResource SurfaceLowest}" BorderBrush="{DynamicResource OutlineVariant}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}" Padding="10,0,4,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <DatePickerTextBox x:Name="PART_TextBox" VerticalAlignment="Center"/>
              <Button x:Name="PART_Button" Grid.Column="1" Style="{StaticResource Btn.Icon}" Width="32" Height="32" MinHeight="32" FontSize="18" Content="&#xEBCC;" AutomationProperties.Name="Choose date"/>
              <Popup x:Name="PART_Popup" PlacementTarget="{Binding ElementName=border}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Outline}"/></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Primary}"/><Setter TargetName="border" Property="BorderThickness" Value="2"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Tree view -->
  <Style TargetType="TreeView">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
  </Style>
  <Style TargetType="TreeViewItem">
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="IsExpanded" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TreeViewItem">
          <StackPanel>
            <Border x:Name="row" CornerRadius="8" Padding="4,6" Background="Transparent" BorderBrush="{DynamicResource Primary}" BorderThickness="0">
              <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="expander" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Width="24" Height="24" Focusable="False" Cursor="Hand">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <TextBlock x:Name="g" Text="&#xE5CC;" FontFamily="{DynamicResource IconFont}" FontSize="18" Foreground="{DynamicResource OnSurfaceVariant}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="g" Property="Text" Value="&#xE5CF;"/></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ItemsPresenter x:Name="items" Margin="20,0,0,0"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="HasItems" Value="False"><Setter TargetName="expander" Property="Visibility" Value="Hidden"/></Trigger>
            <Trigger Property="IsExpanded" Value="False"><Setter TargetName="items" Property="Visibility" Value="Collapsed"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource HoverLayer}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource SecondaryContainer}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="row" Property="BorderThickness" Value="2"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Tab control (styled as a Material secondary tab row) -->
  <Style TargetType="TabControl">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <DockPanel>
            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource SurfaceHigh}" BorderThickness="0,0,0,1" Margin="0,0,0,12"><TabPanel IsItemsHost="True"/></Border>
            <ContentPresenter ContentSource="SelectedContent" m:MotionAttached.Effect="TabContent"/>
          </DockPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="bg" Padding="16,10" BorderThickness="0,0,0,3" BorderBrush="Transparent" Background="Transparent" Cursor="Hand">
            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverLayer}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource Primary}"/><Setter Property="Foreground" Value="{DynamicResource Primary}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource PressLayer}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Group box as a titled tonal section -->
  <Style TargetType="GroupBox">
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GroupBox">
          <Border Background="{DynamicResource SurfaceContainer}" CornerRadius="{DynamicResource RadiusMedium}" Padding="14">
            <StackPanel>
              <ContentPresenter ContentSource="Header" TextElement.FontWeight="SemiBold" TextElement.FontSize="13" TextElement.Foreground="{DynamicResource OnSurfaceVariant}" Margin="0,0,0,8"/>
              <ContentPresenter/>
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Hyperlink">
    <Setter Property="Foreground" Value="{DynamicResource Primary}"/>
    <Setter Property="TextDecorations" Value="Underline"/>
    <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource OnPrimaryContainer}"/></Trigger></Style.Triggers>
  </Style>

  <Style TargetType="RichTextBox">
    <Setter Property="Background" Value="{DynamicResource SurfaceLowest}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariant}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Primary}"/>
    <Setter Property="Padding" Value="10"/>
  </Style>

  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}"/>
    <Setter Property="RowBackground" Value="Transparent"/>
    <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceContainer}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="GridLinesVisibility" Value="None"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="RowHeight" Value="44"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceHigh}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>

  <!-- Indeterminate progress animates a sliding segment instead of the stock glow -->
  <Style x:Key="ProgressIndeterminate" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}"/>

  <Style TargetType="GridSplitter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Focusable" Value="True"/>
  </Style>
</ResourceDictionary>
