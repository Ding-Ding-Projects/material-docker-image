<Window x:Class="BuildCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Material Docker Image build companion" Width="1040" Height="720" MinWidth="720" MinHeight="520"
        Background="{DynamicResource Surface}" FontFamily="{StaticResource TextFont}" Foreground="{DynamicResource OnSurface}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" PreviewKeyDown="OnKey">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock x:Name="TitleText" Style="{StaticResource Heading}" FontSize="22" AutomationProperties.HeadingLevel="Level1"/>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <TextBlock x:Name="RepoLabel" Style="{StaticResource Label}" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="RepoPath" Style="{StaticResource Label}" Foreground="{DynamicResource OnSurface}" FontFamily="{StaticResource MonoFont}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="560" VerticalAlignment="Center"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="LanguageButton" Style="{StaticResource Btn.Outlined}" Margin="0,0,8,0" Click="OnLanguage"/>
        <Button x:Name="ChangeRepoButton" Style="{StaticResource Btn.Outlined}" Click="OnChangeRepo"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock x:Name="SetupHeading" Style="{StaticResource Heading}" AutomationProperties.HeadingLevel="Level2"/>
              <ItemsControl x:Name="SetupList" Margin="0,8,0,8" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,3">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{Binding Brush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Path}" FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="{DynamicResource OnSurface}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Label}" FontSize="12"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="SetupNote" Style="{StaticResource Label}" FontSize="12"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock x:Name="VersionLabel" Style="{StaticResource Label}"/>
              <TextBox x:Name="VersionBox" Margin="0,6,0,2" MaxLength="32" TextChanged="OnVersionChanged"/>
              <TextBlock x:Name="VersionHint" Style="{StaticResource Label}" FontSize="12"/>
              <TextBlock x:Name="VersionError" Style="{StaticResource Label}" Foreground="{DynamicResource Error}" FontSize="12" Visibility="Collapsed"/>
              <Button x:Name="BuildButton" Style="{StaticResource Btn.Filled}" Margin="0,16,0,8" Click="OnBuild"/>
              <Button x:Name="BuildRunButton" Style="{StaticResource Btn.Tonal}" Margin="0,0,0,8" Click="OnBuildRun"/>
              <Button x:Name="InstallerButton" Style="{StaticResource Btn.Tonal}" Margin="0,0,0,8" Click="OnInstaller"/>
              <TextBlock x:Name="InstallerNote" Style="{StaticResource Label}" FontSize="12" Margin="0,0,0,8"/>
              <Button x:Name="CancelButton" Style="{StaticResource Btn.Danger}" Click="OnCancel" IsEnabled="False"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Column="2" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <Border x:Name="StateChip" CornerRadius="8" Padding="12,4" Background="{DynamicResource SecondaryContainer}" VerticalAlignment="Center">
                <TextBlock x:Name="StateText" FontWeight="SemiBold" Foreground="{DynamicResource OnSecondaryContainer}" AutomationProperties.LiveSetting="Polite"/>
              </Border>
              <TextBlock x:Name="PhaseText" Style="{StaticResource Label}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <TextBlock x:Name="ElapsedText" Style="{StaticResource Label}" Margin="0,0,16,0" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}"/>
              <TextBlock x:Name="ExitText" Style="{StaticResource Label}" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}"/>
            </StackPanel>
          </Grid>
          <ProgressBar x:Name="Progress" Grid.Row="1" Height="6" Margin="0,10,0,10" Minimum="0" Maximum="100" Foreground="{DynamicResource Primary}" Background="{DynamicResource SurfaceHigh}" BorderThickness="0"/>
          <TextBox x:Name="LogBox" Grid.Row="2" IsReadOnly="True" IsReadOnlyCaretVisible="True" AcceptsReturn="True" TextWrapping="NoWrap"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                   Background="{DynamicResource SurfaceLowest}"/>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="ShortcutText" Style="{StaticResource Label}" FontSize="12" VerticalAlignment="Center"/>
      <Button x:Name="CopyButton" Grid.Column="1" Style="{StaticResource Btn.Outlined}" Click="OnCopy"/>
    </Grid>
  </Grid>
</Window>
